{
  "name": "pawchive-downloader",
  "description": "Download posts, attachments and whole creators from Pawchive, right in your browser.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "VoxDroid",
  "homepage": "https://github.com/VoxDroid/PawchiveDownloader-BrowserExtension",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoxDroid/PawchiveDownloader-BrowserExtension.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:locales": "node scripts/check-locales.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run lint:locales && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "packageManager": "pnpm@10.30.1"
}
